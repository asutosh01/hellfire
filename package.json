  "description": "Desktop web browser built with Electron and Chromium, featuring custom dark chrome, WebGL flame new tab, tracker blocking, and dual-pane split view.",
  "main": "standalone/main.js",
  "scripts": {
    "start": "node standalone/node_modules/electron/cli.js standalone/.",
